# Local SQLite settings. For SQLite production, use private, durable storage.
PORT=5173
DATA_DIR=data
# DB_PATH=/absolute/path/to/salon.sqlite
# BACKUP_DIR=/absolute/path/to/private/backups

# Render Free requires a Neon PostgreSQL connection string, supplied in Render environment settings.
# DATABASE_URL=
# REQUIRE_DATABASE_URL=1
# One-time first admin (used only when the database has no admins).
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# Use 1 only if the service is behind exactly one trusted reverse proxy.
# TRUST_PROXY=1
# HTTPS is the default. Change this only for localhost development.
# COOKIE_SECURE=0

# Set all three to enable online checkout. Never expose the two secrets to the browser.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Optional booking SMS via Twilio.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
